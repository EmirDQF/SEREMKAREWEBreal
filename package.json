{
  "name": "sermekare-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio estático SERMEKARE — Tailwind CSS compilado (dist/output.css)",
  "scripts": {
    "icons": "node scripts/build-icons.js",
    "dev": "npm run icons && tailwindcss -i ./input.css -o ./dist/output.css --watch",
    "build": "npm run icons && tailwindcss -i ./input.css -o ./dist/output.css --minify"
  },
  "devDependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "subset-font": "^2.9.0",
    "tailwindcss": "3.4.17"
  }
}
